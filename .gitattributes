# Fabrication outputs (Gerber/NC-drill files, DRC reports) are generated by
# Altium's CAM export, not hand-written source. GitHub's language detector
# misreads some of the Gerber mechanical-layer extensions (.GM1, .GM2, ...)
# as Game Maker Language, which skews the repo's "Languages" stats. This
# marks the whole gerber/ folder as generated so it's excluded from those
# stats -- it doesn't change how the files are stored or downloaded.
gerber/* linguist-generated=true
